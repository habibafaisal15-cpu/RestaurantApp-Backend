{
  "name": "restaurant-delivery-backend",
  "version": "1.0.0",
  "description": "REST API + WebSocket backend for restaurant delivery module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "setup": "npm run migrate && npm run seed",
    "db:create": "node scripts/createDatabase.js",
    "db:init": "npm run db:create && npm run setup",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "npm run migrate:rollback -- --all && npm run setup"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  }
}
