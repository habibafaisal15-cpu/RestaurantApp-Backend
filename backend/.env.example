PORT=3000
NODE_ENV=development

# PostgreSQL (default)
DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=restaurant_delivery

# SQLite (optional — set DB_CLIENT=sqlite3)
# DB_CLIENT=sqlite3
# DB_FILENAME=./database/restaurant.db

CORS_ORIGIN=*

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=24h
ADMIN_DEFAULT_EMAIL=admin@restaurant.com
ADMIN_DEFAULT_PASSWORD=Admin@123

# Google Maps (Geocoding, Places, Maps JS)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=

# Email (password reset) — SendGrid, Gmail SMTP, etc.
EMAIL_ENABLED=false
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=
EMAIL_FROM=Restaurant Admin <noreply@yourdomain.com>
ADMIN_FRONTEND_URL=http://localhost:5174
# Return reset token in API when email is off (dev only)
EMAIL_DEV_RETURN_TOKEN=true

# Cloud Postgres (Neon, Supabase, etc.)
DB_SSL=true

# Supabase example (Session pooler — good for Railway app):
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.xxxxxxxxxxxx
# DB_PASSWORD=your-supabase-db-password
# DB_NAME=postgres

# Supabase direct (use for local migrations only):
# DB_HOST=db.xxxxxxxxxxxx.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_NAME=postgres

# Vercel cron auth (generate a random string)
CRON_SECRET=change-this-cron-secret

# Customer site URL (SMS / links)
CUSTOMER_FRONTEND_URL=http://localhost:5173
